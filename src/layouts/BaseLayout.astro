---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import mermaidResponsiveDevUrl from "../scripts/mermaid-responsive-dev.ts?url";

const { title = "shuaibird — thinking, making, moving", showProgress = false } =
  Astro.props;
const isDev = import.meta.env.DEV;
---

<html lang="en">
  <head>
    <SiteHead title={title} />
  </head>
  <body>
    <SiteHeader showProgress={showProgress} />

    <main class="container">
      <slot />
    </main>

    {isDev && <script type="module" src={mermaidResponsiveDevUrl} />}

    <style>
      :global(html, body) {
        overscroll-behavior: none;
      }

      :global(:root) {
        color-scheme: light;
        --color-text: #1f1c1a;
        --color-text-muted: rgba(31, 28, 26, 0.6);
        --color-surface: #ffffff;
        --color-surface-strong: #fff1e6;
        --color-accent: #2a6461;
        --color-accent-strong: #1f4d4b;
        --color-accent-soft: rgba(42, 100, 97, 0.2);
        --color-accent-ghost: rgba(42, 100, 97, 0.12);
        --color-accent-warm: #f07a5a;
        --color-accent-warm-strong: #d96448;
        --color-accent-warm-soft: rgba(240, 122, 90, 0.25);
        --color-accent-warm-ghost: rgba(240, 122, 90, 0.12);
        --color-accent-warm-glow: rgba(240, 122, 90, 0.7);
        --color-border: rgba(31, 28, 26, 0.12);
        --color-hover: rgba(31, 28, 26, 0.06);
        --color-sky: #dff1ff;
        --color-sky-soft: rgba(223, 241, 255, 0.35);
        --color-sand-soft: rgba(255, 219, 190, 0.6);
        --shadow-menu: 0 16px 40px rgba(31, 28, 26, 0.14);
        --shadow-soft: 0 22px 54px rgba(31, 28, 26, 0.12);
        --surface-glass: rgba(255, 255, 255, 0.82);
        --surface-nav: linear-gradient(
          180deg,
          #ffffff 0%,
          #f2fbf9 55%,
          #fff2e6 100%
        );
        --container-padding: clamp(16px, 4vw, 24px);
      }

      :global(body) {
        margin: 0;
        font-family:
          "SF Pro Display",
          "SF Pro Text",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: 17px;
        line-height: 1.65;
        color: var(--color-text);
        background: var(--color-surface);
        text-rendering: optimizeLegibility;
        background-image:
          radial-gradient(
            circle at 18% 12%,
            rgba(42, 100, 97, 0.3),
            rgba(255, 255, 255, 0) 58%
          ),
          radial-gradient(
            circle at 86% 78%,
            rgba(240, 122, 90, 0.16),
            rgba(255, 255, 255, 0) 56%
          ),
          radial-gradient(
            circle at 85% 6%,
            rgba(223, 241, 255, 0.7),
            rgba(255, 255, 255, 0) 48%
          ),
          radial-gradient(
            circle at 78% 78%,
            rgba(42, 100, 97, 0.22),
            rgba(255, 255, 255, 0) 46%
          ),
          linear-gradient(180deg, #e5f6f3 0%, #ffffff 42%, #f2fffc 100%);
        background-attachment: fixed;
      }

      :global(p) {
        margin: 0 0 1.1rem;
      }

      :global(h1),
      :global(h2),
      :global(h3) {
        margin: 0 0 0.6rem;
        line-height: 1.2;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      :global(h1) {
        font-size: 2.6rem;
      }

      :global(h2) {
        font-size: 1.8rem;
      }

      :global(h3) {
        font-size: 1.25rem;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
        transition:
          color 0.2s ease,
          opacity 0.2s ease;
      }

      :global(a, button, summary, [role="button"]) {
        -webkit-tap-highlight-color: transparent;
      }

      :global(a:hover) {
        color: var(--color-accent);
      }

      :global(::selection) {
        background: rgba(42, 100, 97, 0.2);
        color: var(--color-text);
      }

      :global(.sr-only) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      :global(.container) {
        max-width: 1040px;
        margin: 0 auto;
        padding: 0 var(--container-padding);
      }

      main {
        padding: 64px var(--container-padding) 96px;
      }

      :global(pre.astro-code) {
        font-size: 0.95rem;
        line-height: 1.55;
        padding: 1rem 1.2rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
      }

      @media (max-width: 720px) {
        :global(pre.astro-code) {
          font-size: 0.88rem;
        }
      }

      /* === Mermaid diagrams (build wrapper) === */
      :global(div.mermaid) {
        max-width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        background: rgba(0, 0, 0, 0.02);
        padding: 24px;
        border-radius: 16px;

        margin: 32px 0;
        overflow-x: auto;
      }

      /* === Mermaid responsive wrappers (build) === */
      :global(.mermaid-responsive) {
        margin: 32px 0;
      }

      :global(.mermaid-responsive__item) {
        width: 100%;
      }

      :global(.mermaid-responsive__item--tb) {
        display: none;
      }

      :global(.mermaid-responsive .mermaid) {
        margin: 0;
      }

      @media (max-width: 720px) {
        :global(.mermaid-responsive__item--lr) {
          display: none;
        }

        :global(.mermaid-responsive__item--tb) {
          display: block;
        }
      }
    </style>
  </body>
</html>
