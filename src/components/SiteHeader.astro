---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-grid">
    <div class="brand">
      <a href="/">shuaibird</a>
    </div>
    <nav class="nav" aria-label="Primary">
      <a href="/tech/" class:list={{ active: isActive("/tech/") }}>Tech</a>
      <a href="/life/" class:list={{ active: isActive("/life/") }}>Life</a>
      <a href="/about/" class:list={{ active: isActive("/about/") }}>About</a>
    </nav>
    <div class="spacer" aria-hidden="true"></div>
  </div>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      background: #fff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      z-index: 10;
    }

    .header-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      height: 64px;
    }

    .brand {
      justify-self: center;
    }

    .brand a {
      font-size: 0.98rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .nav {
      display: flex;
      gap: 24px;
      font-size: 0.95rem;
      font-weight: 500;
    }

    .nav a {
      padding: 6px 0;
      border-bottom: 2px solid transparent;
      transition:
        opacity 0.2s ease,
        border-color 0.2s ease;
    }

    .nav a:hover {
      opacity: 0.7;
    }

    .nav a.active {
      border-color: #2a6461;
    }
  </style>
</header>
