---
const { items = [] } = Astro.props;
---

<ul class="link-list">
  {
    items.map((item: { href: string; label: string; meta?: string }) => (
      <li>
        <a href={item.href}>
          {item.label}
          {item.meta && <span>{item.meta}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .link-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--surface-glass);
    border: 1px solid var(--color-border);
    font-weight: 600;
    color: var(--color-text);
  }

  .link-list a:hover {
    color: var(--color-accent-strong);
    background: var(--color-accent-ghost);
  }

  .link-list a span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
