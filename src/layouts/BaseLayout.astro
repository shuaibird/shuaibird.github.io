---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";

const { title = "shuaibird — thinking, making, moving" } = Astro.props;
---

<html lang="en">
  <head>
    <SiteHead title={title} />
  </head>
  <body>
    <SiteHeader />

    <main class="container">
      <slot />
    </main>

    <style>
      :global(:root) {
        color-scheme: light;
      }

      :global(body) {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: 17px;
        line-height: 1.6;
        color: #1c1c1c;
        background: #fff;
        text-rendering: optimizeLegibility;
      }

      :global(p) {
        margin: 0 0 1.1rem;
      }

      :global(h1),
      :global(h2),
      :global(h3) {
        margin: 0 0 0.6rem;
        line-height: 1.2;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      :global(h1) {
        font-size: 2.4rem;
      }

      :global(h2) {
        font-size: 1.7rem;
      }

      :global(h3) {
        font-size: 1.2rem;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(.container) {
        max-width: 1040px;
        margin: 0 auto;
        padding: 0 20px;
      }

      main {
        padding: 48px 0 72px;
      }
    </style>
  </body>
</html>
