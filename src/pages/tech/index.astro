---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionCard from "../../components/SectionCard.astro";
import LinkList from "../../components/LinkList.astro";
import { techSeries } from "../../data/techSeries";

const seriesItems = techSeries.map((series) => ({
  href: `/tech/${series.slug}/`,
  label: series.title,
  meta: series.meta,
}));
---

<BaseLayout title="Tech — shuaibird">
  <PageHero
    kicker="Tech"
    title="Tech"
    subtitle="Notes on tools, systems, and quiet experiments."
  />

  <SectionCard title="Series">
    <LinkList items={seriesItems} />
  </SectionCard>
</BaseLayout>
