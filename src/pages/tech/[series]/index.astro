---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import SectionCard from "../../../components/SectionCard.astro";
import { getCollection } from "astro:content";
import { techSeries, type TechSeries } from "../../../data/techSeries";

export async function getStaticPaths() {
  return techSeries.map((series) => ({
    params: { series: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props as { series: TechSeries };

const posts = (await getCollection(series.collection))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
});
---

<BaseLayout title={`${series.title} — shuaibird`}>
  <PageHero
    variant="solo"
    kicker={series.kicker}
    title={series.title}
    subtitle={series.subtitle}
  />

  <SectionCard title="Posts">
    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-item">
            <a href={`/tech/${series.slug}/${post.slug}/`}>
              <div class="post-title">{post.data.title}</div>
              <div class="post-meta">
                <span>{formatter.format(post.data.date)}</span>
                {post.data.description && (
                  <span class="post-desc">{post.data.description}</span>
                )}
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </SectionCard>

  <style>
    .post-list {
      display: grid;
      gap: 14px;
    }

    .post-item a {
      display: grid;
      gap: 6px;
      padding: 12px 14px;
      border-radius: 14px;
      background: var(--surface-glass);
      border: 1px solid var(--color-border);
    }

    .post-title {
      font-weight: 600;
    }

    .post-meta {
      display: grid;
      gap: 4px;
      font-size: 0.9rem;
      color: var(--color-text-muted);
    }

    .post-desc {
      color: var(--color-text-muted);
    }
  </style>
</BaseLayout>
