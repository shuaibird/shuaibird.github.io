---
import { techSeries } from "../data/techSeries";

const { showProgress = false } = Astro.props;
const pathname = Astro.url.pathname;
const isActiveSection = (href: string) => pathname.startsWith(href);
const isActiveLink = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="site-header" class:list={{ "has-progress": showProgress }}>
  <div class="container header-grid">
    <div class="brand">
      <a href="/">shuaibird</a>
    </div>
    <nav id="primary-nav" class="nav" aria-label="Primary">
      <button class="nav-close" type="button">Close</button>
      <details class="menu" class:list={{ active: isActiveSection("/tech/") }}>
        <summary class="menu-trigger">Tech</summary>
        <div class="menu-panel">
          {
            techSeries.map((series) => (
              <a
                href={`/tech/${series.slug}/`}
                class:list={{ active: isActiveLink(`/tech/${series.slug}/`) }}
              >
                {series.title}
              </a>
            ))
          }
        </div>
      </details>
      <details class="menu" class:list={{ active: isActiveSection("/life/") }}>
        <summary class="menu-trigger">Life</summary>
        <div class="menu-panel">
          <a
            href="/life/climbing/"
            class:list={{ active: isActiveLink("/life/climbing/") }}>Climbing</a
          >
          <a
            href="/life/music/"
            class:list={{ active: isActiveLink("/life/music/") }}>Music</a
          >
        </div>
      </details>
      <a href="/about/" class:list={{ active: isActiveSection("/about/") }}
        >About</a
      >
      <a href="/search/" class:list={{ active: isActiveSection("/search/") }}
        >Search</a
      >
    </nav>
    <div class="header-actions">
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        Menu
      </button>
    </div>
  </div>
  <div class="nav-backdrop" aria-hidden="true"></div>

  <script is:inline>
    // Ensure only one <details> dropdown is open at a time.
    const menus = Array.from(
      document.querySelectorAll(".site-header details.menu"),
    );

    for (const menu of menus) {
      menu.addEventListener("toggle", () => {
        if (!menu.open) return;
        for (const other of menus) {
          if (other !== menu) other.open = false;
        }
      });
    }

    const header = document.querySelector(".site-header");
    const toggleButton = header?.querySelector(".nav-toggle");
    const closeButton = header?.querySelector(".nav-close");
    const backdrop = header?.querySelector(".nav-backdrop");

    const setNavOpen = (open) => {
      if (!header) return;
      header.classList.toggle("nav-open", open);
      if (toggleButton instanceof HTMLElement) {
        toggleButton.setAttribute("aria-expanded", open ? "true" : "false");
      }
      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = open ? "hidden" : "";
      document.body.style.paddingRight = open ? `${scrollbarWidth}px` : "";
    };

    toggleButton?.addEventListener("click", () => {
      const isOpen = header?.classList.contains("nav-open");
      setNavOpen(!isOpen);
    });

    closeButton?.addEventListener("click", () => setNavOpen(false));
    backdrop?.addEventListener("click", () => setNavOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!header?.classList.contains("nav-open")) return;
      setNavOpen(false);
    });

    // Close any open menu when selecting a dropdown item.
    header?.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const link = target.closest("a");
      if (!link) return;

      const inPanel = link.closest(".menu-panel");
      if (inPanel) {
        for (const menu of menus) menu.open = false;
      }

      setNavOpen(false);
    });

    const progressEnabled =
      header instanceof HTMLElement &&
      header.classList.contains("has-progress");

    if (progressEnabled && header instanceof HTMLElement) {
      let ticking = false;

      const updateProgress = () => {
        const doc = document.documentElement;
        const scrollTop = window.scrollY || doc.scrollTop;
        const maxScroll = doc.scrollHeight - window.innerHeight;
        const progress =
          maxScroll <= 0 ? 0 : Math.min(Math.max(scrollTop / maxScroll, 0), 1);

        header.style.setProperty("--header-progress", progress.toFixed(4));
        header.style.setProperty(
          "--header-progress-percent",
          `${(progress * 100).toFixed(2)}%`,
        );
        header.classList.toggle("progress-ready", maxScroll > 0);
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
      };

      updateProgress();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      window.addEventListener("load", updateProgress);
    }
  </script>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      --header-height: 80px;
      --nav-control-height: 32px;
      --nav-control-border: 1px;
      --header-progress: 0;
      --header-progress-percent: 0%;
      --header-progress-gradient: linear-gradient(
        90deg,
        rgba(12, 148, 138, 0.55),
        rgba(18, 154, 144, 0.99),
        rgba(255, 155, 95, 1)
      );
      background: var(--surface-glass);
      border-bottom: 1px solid var(--color-border);
      backdrop-filter: blur(14px);
      box-shadow: 0 8px 20px rgba(18, 18, 18, 0.06);
      z-index: 10;
    }

    .site-header::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgba(42, 100, 97, 0.15),
        rgba(42, 100, 97, 0.7),
        rgba(255, 219, 190, 0.6)
      );
      opacity: 0.8;
      pointer-events: none;
    }

    .site-header::before {
      content: "";
      position: absolute;
      inset: auto 0 -1px;
      height: 4px;
      background: var(--header-progress-gradient);
      opacity: 1;
      clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
      transition: none;
      pointer-events: none;
      will-change: clip-path;
    }

    .site-header.progress-ready::before {
      clip-path: polygon(
        0 0,
        var(--header-progress-percent, 0%) 0,
        var(--header-progress-percent, 0%) 100%,
        0 100%
      );
      transition: clip-path 0.12s ease-out;
    }

    .site-header:not(.has-progress)::before {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .site-header::before {
        transition: none;
      }
    }

    .header-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      height: var(--header-height);
    }

    .brand {
      justify-self: start;
    }

    .header-actions {
      justify-self: end;
    }

    .brand a {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--color-text);
    }

    .nav-toggle,
    .nav-close {
      border: var(--nav-control-border) solid var(--color-accent-soft);
      background: var(--color-accent-ghost);
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: var(--nav-control-height);
      padding: 0 14px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      color: var(--color-accent-strong);
    }

    .nav {
      display: flex;
      gap: 28px;
      font-size: 1.02rem;
      font-weight: 600;
      align-items: center;
    }

    .nav > a,
    .menu-trigger {
      padding: 10px 4px;
      border-bottom: 2px solid transparent;
      transition:
        opacity 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .nav a:hover,
    .menu-trigger:hover {
      opacity: 1;
      color: var(--color-accent);
    }

    .nav a.active,
    .menu.active .menu-trigger {
      border-color: var(--color-accent);
    }

    .menu {
      position: relative;
      margin: 0;
    }

    .menu-trigger {
      list-style: none;
      cursor: pointer;
      display: inline-block;
    }

    /* Remove default disclosure marker across browsers */
    .menu-trigger::marker {
      content: "";
    }

    .menu-trigger::-webkit-details-marker {
      display: none;
    }

    .menu-panel {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      transform: none;
      min-width: 200px;
      padding: 8px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(31, 31, 31, 0.08);
      border-radius: 12px;
      box-shadow: 0 10px 24px rgba(31, 28, 26, 0.12);
      display: none;
      flex-direction: column;
      gap: 2px;
      z-index: 20;
    }

    .menu[open] .menu-panel {
      display: flex;
    }

    .menu-panel a {
      display: block;
      border-bottom: 1px solid transparent;
      padding: 8px 10px;
      border-radius: 10px;
    }

    .menu-panel a:hover {
      background: var(--color-accent-ghost);
      opacity: 1;
    }

    .menu-panel a.active {
      color: var(--color-accent);
      border-color: transparent;
      opacity: 1;
    }

    .nav-toggle,
    .nav-close,
    .nav-backdrop {
      display: none;
    }

    @media (max-width: 720px) {
      .header-grid {
        grid-template-columns: auto 1fr auto;
      }

      .nav-toggle {
        display: inline-flex;
        justify-self: end;
      }

      .nav-backdrop {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(20, 20, 20, 0.35);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 15;
      }

      .nav {
        position: fixed;
        inset: 0;
        min-height: 100dvh;
        padding: calc((var(--header-height) - var(--nav-control-height)) / 2)
          var(--container-padding) 28px;
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
        background-color: var(--color-surface);
        background-image: var(--surface-nav);
        background-size: cover;
        visibility: hidden;
        pointer-events: none;
        transform: translate3d(0, -4px, 0);
        transition:
          transform 0.22s ease-out,
          visibility 0s linear 0.22s;
        z-index: 20;
        border-radius: 0;
        box-shadow: none;
      }

      .nav-open .nav {
        visibility: visible;
        pointer-events: auto;
        transform: translate3d(0, 0, 0);
        transition: transform 0.22s ease-out;
      }

      .nav-open .nav-backdrop {
        opacity: 1;
        pointer-events: auto;
      }

      .nav-close {
        display: inline-flex;
        align-self: flex-end;
        margin-bottom: 8px;
      }

      .menu {
        width: 100%;
      }

      .menu-trigger {
        width: 100%;
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
      }

      .menu-panel {
        position: static;
        transform: none;
        min-width: 0;
        margin-top: 6px;
        padding: 6px 12px 8px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(31, 31, 31, 0.08);
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(31, 28, 26, 0.08);
      }

      .menu-panel a {
        padding: 8px 4px;
      }
    }
  </style>
</header>
