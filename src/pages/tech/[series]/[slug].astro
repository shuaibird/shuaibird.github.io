---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import SectionCard from "../../../components/SectionCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import fs from "node:fs/promises";
import path from "node:path";
import {
  techSeries,
  type TechSeries,
  type TechSeriesCollection,
} from "../../../data/techSeries";

const loadSearchMeta = async (
  collection: string,
  slug: string,
  fallbackTitle: string,
  fallbackDescription?: string,
) => {
  const metaPath = path.resolve(
    "src/data/search/entries",
    collection,
    `${slug}.json`,
  );

  try {
    const raw = await fs.readFile(metaPath, "utf8");
    return JSON.parse(raw);
  } catch {
    return {
      title: fallbackTitle,
      description: fallbackDescription ?? "",
      keywords: [],
      phrases: [],
      summary: fallbackDescription ?? "",
    };
  }
};

export async function getStaticPaths() {
  const seriesEntries = await Promise.all(
    techSeries.map(async (series) => {
      const posts = await getCollection(series.collection);
      return posts
        .filter((post) => !post.data.draft)
        .map((post) => ({
          params: { series: series.slug, slug: post.slug },
          props: { series, post },
        }));
    }),
  );

  return seriesEntries.flat();
}

const { series, post } = Astro.props as {
  series: TechSeries;
  post: CollectionEntry<TechSeriesCollection>;
};
const { Content } = await post.render();
const searchMeta = await loadSearchMeta(
  post.collection,
  post.slug,
  post.data.title,
  post.data.description,
);
const searchTerms = [
  ...(Array.isArray(searchMeta?.keywords) ? searchMeta.keywords : []),
  ...(Array.isArray(searchMeta?.phrases) ? searchMeta.phrases : []),
]
  .filter(Boolean)
  .join(" ");
const formatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
});
---

<BaseLayout title={`${post.data.title} — ${series.title}`} showProgress>
  <PageHero
    variant="solo"
    kicker={formatter.format(post.data.date)}
    title={post.data.title}
    subtitle={post.data.description}
  />

  <SectionCard>
    <div class="post-body" data-pagefind-body>
      <Content />
      {
        searchTerms && (
          <div class="sr-only" aria-hidden="true">
            {searchTerms}
          </div>
        )
      }
      <div class="sr-only" aria-hidden="true">
        <span data-pagefind-meta="series">{series.title}</span>
        <span data-pagefind-meta="collection">{post.collection}</span>
        {
          searchMeta?.summary && (
            <span data-pagefind-meta="summary">{searchMeta.summary}</span>
          )
        }
        {
          Array.isArray(searchMeta?.keywords) &&
            searchMeta.keywords.length > 0 && (
              <span data-pagefind-meta="keywords">
                {searchMeta.keywords.join(" ")}
              </span>
            )
        }
        {
          Array.isArray(searchMeta?.phrases) &&
            searchMeta.phrases.length > 0 && (
              <span data-pagefind-meta="phrases">
                {searchMeta.phrases.join(" ")}
              </span>
            )
        }
      </div>
    </div>
  </SectionCard>

  <style>
    .post-body :global(p) {
      margin: 0 0 1.1rem;
    }

    .post-body :global(h2) {
      margin-top: 1.6rem;
    }

    .post-body :global(blockquote) {
      margin: 1.2rem 0;
      padding: 12px 18px;
      border-left: 3px solid var(--color-accent);
      border-radius: 12px;
      background: var(--surface-glass);
      color: var(--color-text);
    }

    .post-body :global(blockquote p) {
      margin: 0.4rem 0;
    }

    .post-body :global(blockquote p:first-child) {
      margin-top: 0;
    }

    .post-body :global(blockquote p:last-child) {
      margin-bottom: 0;
    }
  </style>
</BaseLayout>
